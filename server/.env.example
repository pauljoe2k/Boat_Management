# Harbour Desk backend — copy to server/.env and adjust.
# The frontend's own env file lives at the repository root (.env) and is untouched by this project.

# HTTP port the API listens on (contract base URL is http://localhost:4000/api)
PORT=4000

# Local PostgreSQL from docker-compose.yml (run `docker compose up -d` at the repo root)
DATABASE_URL=postgresql://harbour:harbour@localhost:5432/harbour_desk

# HS256 signing secret for access tokens. MUST be set explicitly when NODE_ENV=production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins, or * (tokens are sent in an Authorization header,
# so no cookies and therefore no CSRF surface)
CORS_ORIGIN=*

# Attachment upload ceiling in bytes (5 MiB) and allowed types are image/* + application/pdf
UPLOAD_MAX_BYTES=5242880

# Reminder worker poll interval in milliseconds
REMINDER_POLL_MS=60000

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
